# Optional local configuration. Copy to .env (never commit .env).
DFIS_DATA_DIR=./backend/data
DFIS_MAX_UPLOAD_MB=25
DFIS_SESSION_HOURS=8
DFIS_COOKIE_SECURE=false        # set true when served over HTTPS
DFIS_CORS_ORIGINS=http://localhost:5173
DFIS_LOGIN_MAX_ATTEMPTS=5
DFIS_LOGIN_WINDOW_SECONDS=300
# DFIS_ADMIN_PASSWORD=          # optional, for non-interactive init only; do not store long-term
